{
  "name": "tabdance-elvish-tree-sitter",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Elvish and Elvish transcript grammars for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parsing",
    "incremental",
    "elvish",
    "elvish-transcript",
    "tree-sitter"
  ],
  "files": [
    "elvish/grammar.js",
    "elvish_transcript/grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "elvish/queries/*",
    "elvish_transcript/queries/*",
    "elvish/src/**",
    "elvish_transcript/src/**"
  ],
  "tree-sitter": [
    {
      "scope": "source.elvish",
      "path": "elvish",
      "file-types": [
        "elv"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^elvish$"
    },
    {
      "scope": "source.elvish-transcript",
      "path": "elvish_transcript",
      "file-types": [
        "elvts"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^(elvish-transcript|elvts)$"
    }
  ],
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "scripts": {
    "install": "node-gyp-build",
    "test": "node scripts/test-all.mjs",
    "test:node": "node --test bindings/node/binding_test.js",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:queries": "node scripts/check-queries.mjs"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/tab-dance/tabdance-elvish-tree-sitter.git"
  }
}
