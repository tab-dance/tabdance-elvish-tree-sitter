{
  "name": "tree-sitter-elvish",
  "version": "0.0.1",
  "description": "elvish grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parsing",
    "incremental",
    "elvish",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "tree-sitter": [
    {
      "scope": "source.elvish",
      "file-types": [
        "elv"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^elvish$"
    }
  ],
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "scripts": {
    "install": "node-gyp-build",
    "test": "tree-sitter test",
    "test:node": "node --test bindings/node/binding_test.js",
    "check:metadata": "node scripts/check-metadata.mjs"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/tab-dance/tree-sitter-elvish.git"
  }
}
